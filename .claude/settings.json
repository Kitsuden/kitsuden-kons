{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build)",
      "Bash(pnpm kon:sync)",
      "Bash(pnpm kon:sync:check)",
      "Bash(pnpm maturity)",
      "Bash(pnpm maturity:check)",
      "Bash(pnpm vitest run:*)",
      "Bash(pnpm exec vitest run:*)",
      "Bash(pnpm exec tsc --noEmit:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(git push:*)",
      "Bash(pnpm publish:*)"
    ]
  }
}
