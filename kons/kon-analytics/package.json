{
  "name": "@kitsuden/kon-analytics",
  "version": "1.0.1",
  "description": "View counter per subject and day, with no cookies or personal data",
  "type": "module",
  "main": "./index.ts",
  "files": [
    "AGENTS.md",
    "README.md",
    "analytics.routes.ts",
    "analytics.schema.ts",
    "index.ts",
    "kon.json",
    "migrations"
  ],
  "types": "./index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "pnpm exec tsc",
    "dev": "pnpm exec tsc --watch"
  },
  "keywords": [
    "kitsuden",
    "kon",
    "analytics",
    "views"
  ],
  "author": "Victor Antinori Broce (https://github.com/vigogami)",
