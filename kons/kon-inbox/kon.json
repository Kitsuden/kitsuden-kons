{
  "$schema": "../../schemas/kon-schema.json",
  "id": "kon-inbox",
  "name": "Inbox",
  "description": "A person's mailbox and calendar (Gmail, Google Calendar, Microsoft 365), synced through kon-connections, matched to CRM contacts, with the owner deciding who sees each thread",
  "version": "0.1.0",
  "sdk": 1,
  "type": "kon",
  "tier": "specialized",
  "maturity": "beta",
  "icon": "Inbox",
  "kitsuden": ">=0.9.0",
  "mount": {
    "path": "/api/inbox"
  },
  "tables": [
    {
      "name": "inbox_mailboxes",
      "label": "Mailboxes",
      "icon": "Inbox"
    },
    {
      "name": "inbox_threads",
      "label": "Threads",
      "icon": "Mail"
    },
    {
      "name": "inbox_messages",
      "label": "Messages",
      "icon": "Mail"
    },
    {
      "name": "inbox_events",
      "label": "Calendar events",
      "icon": "Calendar"
    }
  ],
  "admin": {
    "category": "tools",
    "views": [
      {
        "id": "grid-mailboxes",
        "type": "grid",
        "title": "Mailboxes",
        "table": "inbox_mailboxes",
        "singularName": "mailbox",
        "icon": "Inbox"
      }
    ]
  },
  "dependencies": {
    "kons": [
      "kon-connections"
    ],
    "core": [
      "auth"
    ],
    "optionalKons": [
      "kon-crm"
    ],
    "versions": {
      "kon-connections": "^0.1.0"
    }
  },
  "schema": {
    "entry": null,
    "strategy": "sql"
  },
  "category": "business"
}
