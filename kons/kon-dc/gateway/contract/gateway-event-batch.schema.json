{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "number",
      "const": 1
    },
    "events": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "type": "string",
            "enum": [
              "GUILD_CREATE",
              "GUILD_UPDATE",
              "GUILD_DELETE",
              "GUILD_MEMBER_ADD",
              "GUILD_MEMBER_REMOVE",
              "GUILD_BAN_ADD",
              "MESSAGE_CREATE",
              "MESSAGE_UPDATE",
              "MESSAGE_DELETE",
              "MESSAGE_REACTION_ADD",
              "MESSAGE_REACTION_REMOVE",
              "VOICE_STATE_UPDATE",
              "GUILD_AUDIT_LOG_ENTRY_CREATE"
            ]
          },
          "s": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Sequence number on its shard"
          },
          "shard": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2,
            "description": "[shard id, shard count]"
          },
          "receivedAt": {
            "type": "string",
            "description": "RFC 3339, when the worker read it"
          },
          "d": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "t",
          "s",
          "shard",
          "receivedAt",
          "d"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract",
    "events"
  ],
  "additionalProperties": false
}
