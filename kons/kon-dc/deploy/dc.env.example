# kon-dc — settings for the Compose overlay. Copy the lines you need into the .env next to
# Kitsuden's docker-compose.yml. Never commit real values.

# Developer Portal → your application → General Information
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Developer Portal → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Modules switched off for the whole installation, comma-separated (e.g. "ai,leveling").
DISCORD_DISABLED_MODULES=

# Profile dc-gateway: an agent key with only these two scopes:
#   kon:dc:gateway-config, kon:dc:ingest-gateway-events
DISCORD_GATEWAY_AGENT_KEY=
# Where the kons checkout is, relative to the Kitsuden checkout (for the worker's build context).
KITSUDEN_KONS_DIR=../kitsuden-kons
# 0 = the shard count Discord recommends. Split shards across workers with DISCORD_SHARD_IDS=0,1.
DISCORD_SHARD_COUNT=0
DISCORD_SHARD_IDS=

# Blueprints that call other kons (kon_call, selects and autocomplete fed by a kon, panel data):
# the bot's OWN agent key. Give it only the scopes those blueprints need; for the broadcast booth:
#   kon:broadcast:list-sets, get-set, update-set, scoreboard, screens, swap-sides, reset-set,
#   startgg-sets, apply-startgg-set (each as kon:broadcast:<operation>)
DISCORD_BOT_AGENT_KEY=
# start.gg import in the broadcast booth reads STARTGG_TOKEN in the API.

# Image cards: extra https hosts card images (item backgrounds) may come from, comma-separated.
# Discord's CDN always may. The API's image also needs a font (Alpine: font-dejavu).
DISCORD_CARD_IMAGE_HOSTS=
# The feeds module's Twitch live checks (an app at dev.twitch.tv).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# The member page's Discord login: the app's client secret, this API's /api/dc/member/callback
# (add it in the Developer Portal → OAuth2 → Redirects) and 32+ random characters for sessions.
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URL=
DISCORD_MEMBER_SECRET=
# Plans: modules only premium servers can switch on, and blueprints a free server can have on.
DISCORD_PREMIUM_MODULES=
DISCORD_FREE_BLUEPRINTS=
