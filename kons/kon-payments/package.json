{
  "name": "@kitsuden/kon-payments",
  "version": "1.1.1",
  "description": "Payments & subscriptions kon for Kitsuden",
  "type": "module",
  "main": "./index.ts",
  "files": [
    "AGENTS.md",
    "README.md",
    "index.ts",
    "kon.json",
    "migrations",
    "operations.ts",
    "payments.orders.ts",
    "payments.policy.ts",
