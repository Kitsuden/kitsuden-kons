    "payments.service.ts",
    "payments.types.ts",
    "providers"
  ],
  "types": "./index.ts",
  "keywords": [
    "kitsuden",
    "kon",
    "payments",
    "stripe",
    "paddle",
    "paypal",
    "lemonsqueezy"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "hono": "^4.7.0",
    "drizzle-orm": "^0.45.0",
    "zod": "^4.6.7"
  },
  "kitsuden": {
    "type": "kon",
    "id": "kon-payments",
