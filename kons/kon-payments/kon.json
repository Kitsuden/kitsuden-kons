{
  "$schema": "../../schemas/kon-schema.json",
  "id": "kon-payments",
  "name": "Payments",
  "description": "Payments and subscriptions with Stripe, Lemon Squeezy, Paddle and PayPal",
  "version": "1.1.1",
  "sdk": 1,
  "type": "kon",
  "tier": "common",
  "maturity": "experimental",
  "icon": "CreditCard",
  "category": "business",
  "core": false,
  "defaultEnabled": false,
  "mount": {
    "path": "/api/payments",
    "router": "createPaymentsKon"
  },
  "entryPoint": "./index.ts",
  "schema": {
    "entry": "./payments.schema.ts",
    "strategy": "drizzle"
  },
  "tables": [
    "pay_customers",
    "pay_subscriptions",
    "pay_events"
  ],
  "dependencies": {
    "kons": [],
    "core": [
      "auth"
    ],
    "optionalKons": [
      "kon-conta"
    ]
  },
  "compatibility": {
    "kitsuden": ">=0.9.0"
  }
}
