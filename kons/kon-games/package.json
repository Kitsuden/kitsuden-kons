{
  "name": "@kitsuden/kon-games",
  "version": "2.1.1",
  "description": "Game library with IGDB integration, collections, platforms, tags, screenshots, and trailers",
  "type": "module",
  "main": "./index.ts",
  "files": [
    "AGENTS.md",
    "README.md",
    "games.db.ts",
    "games.editorial.ts",
    "games.policy.ts",
    "games.routes.ts",
    "games.schema.ts",
    "index.ts",
    "kon.json",
    "migrations",
    "operations.ts"
  ],
  "types": "./index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "pnpm exec tsc",
    "dev": "pnpm exec tsc --watch"
  },
  "keywords": [
    "kitsuden",
    "kon",
    "games",
    "igdb",
    "catalog",
    "gaming"
  ],
  "author": "Victor Antinori Broce (https://github.com/vigogami)",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "hono": "^4.7.0",
    "drizzle-orm": "^0.45.0"
  },
  "kitsuden": {
    "type": "kon",
    "id": "kon-games",
    "category": "gaming",
    "order": 12,
    "core": false,
    "defaultEnabled": false,
    "minVersion": "0.8.0",
    "host": "Provided by the Kitsuden host: @kitsuden/shared, @kitsuden/engine (compatibility = \"sdk\" in kon.json)"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kitsuden/kitsuden-kons.git",
    "directory": "kons/kon-games"
  }
}
