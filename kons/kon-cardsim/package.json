{
  "name": "@kitsuden/kon-cardsim",
  "version": "2.6.0",
  "description": "Card simulator builder: games defined by data, deterministic sessions with replay, a deck showcase and a hand generator",
  "type": "module",
  "main": "./index.ts",
  "files": [
    "AGENTS.md",
    "Board.svelte",
    "ImageSourcesPanel.svelte",
    "README.md",
    "TableBoard.svelte",
    "cardsim.arbiter.ts",
    "cardsim.board.i18n.ts",
    "cardsim.dataset.ts",
    "cardsim.deck.ts",
    "cardsim.decklist.ts",
    "cardsim.engine.ts",
    "cardsim.goldfish.ts",
    "cardsim.images.client.ts",
    "cardsim.images.controller.ts",
    "cardsim.images.ts",
    "cardsim.placeholder.ts",
    "cardsim.policy.ts",
    "cardsim.presets.ts",
    "cardsim.rating.ts",
    "cardsim.relay.ts",
    "cardsim.render.ts",
    "cardsim.schema.ts",
    "cardsim.seed.ts",
    "cardsim.solo.ts",
    "cardsim.statecache.ts",
    "cardsim.table.client.ts",
    "cardsim.table.i18n.ts",
    "cardsim.types.ts",
    "cardsim.zip.ts",
    "deckshow.policy.ts",
    "deckshow.routes.ts",
    "deckshow.schema.ts",
    "handlab.definition.ts",
    "handlab.policy.ts",
    "handlab.routes.ts",
    "handlab.schema.ts",
    "index.ts",
    "kon.json",
    "migrations",
    "operations.ts"
  ],
  "types": "./index.ts",
  "scripts": {
    "build": "pnpm exec tsc",
    "dev": "pnpm exec tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "kitsuden",
    "kon",
    "cardsim",
    "deckshow",
    "handlab",
    "tcg",
    "goldfish",
    "byod"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "hono": "^4.7.0",
    "drizzle-orm": "^0.45.0",
    "zod": "^4.6.7",
    "svelte": "^5.0.0"
  },
  "kitsuden": {
    "type": "kon",
    "id": "kon-cardsim",
    "core": false,
    "defaultEnabled": false,
    "host": "Provided by the Kitsuden host: @kitsuden/shared, @kitsuden/engine (compatibility = \"sdk\" in kon.json)"
  },
  "exports": {
    ".": "./index.ts",
    "./motor": "./cardsim.engine.ts",
    "./presets": "./cardsim.presets.ts",
    "./decklist": "./cardsim.decklist.ts",
    "./images": "./cardsim.images.client.ts",
    "./images/controller": "./cardsim.images.controller.ts",
    "./solo": "./cardsim.solo.ts",
    "./board": "./Board.svelte",
    "./board/sources": "./ImageSourcesPanel.svelte",
    "./board/texts": "./cardsim.board.i18n.ts",
    "./table": "./cardsim.table.client.ts",
    "./relay": "./cardsim.relay.ts",
    "./render": "./cardsim.render.ts",
    "./arbiter": "./cardsim.arbiter.ts",
    "./board/table": "./TableBoard.svelte",
    "./board/table/texts": "./cardsim.table.i18n.ts",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kitsuden/kitsuden-kons.git",
    "directory": "kons/kon-cardsim"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  }
}
