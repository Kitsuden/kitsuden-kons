{
  "name": "@kitsuden/kon-collection",
  "version": "1.0.1",
  "description": "Each reader's collection over an index with records: what they have and what they lack",
  "type": "module",
  "main": "./index.ts",
  "files": [
    "AGENTS.md",
    "README.md",
    "collection.policy.ts",
    "collection.schema.ts",
    "index.ts",
    "kon.json",
    "migrations",
    "operations.ts"
  ],
  "types": "./index.ts",
  "scripts": {
    "build": "pnpm exec tsc",
    "dev": "pnpm exec tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "kitsuden",
    "kon",
    "collection"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "hono": "^4.7.0",
    "drizzle-orm": "^0.45.0",
    "zod": "^4.6.7"
  },
  "kitsuden": {
    "type": "kon",
    "id": "kon-collection",
    "core": false,
    "defaultEnabled": false,
    "host": "Provided by the Kitsuden host: @kitsuden/shared, @kitsuden/engine (compatibility = \"sdk\" in kon.json)"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kitsuden/kitsuden-kons.git",
    "directory": "kons/kon-collection"
  }
}
