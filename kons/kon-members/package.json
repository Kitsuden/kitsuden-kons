{
  "name": "@kitsuden/kon-members",
  "version": "1.0.1",
  "description": "Paid memberships for Kitsuden: tiers, members and access control",
  "type": "module",
  "main": "./index.ts",
  "files": [
    "AGENTS.md",
    "README.md",
    "index.ts",
    "kon.json",
    "members.access.ts",
    "members.mails.ts",
    "members.policy.ts",
    "members.routes.ts",
    "members.schema.ts",
    "members.service.ts",
    "migrations",
    "operations.ts"
  ],
  "types": "./index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "pnpm exec tsc",
    "dev": "pnpm exec tsc --watch"
  },
  "keywords": [
    "kitsuden",
    "kon",
    "members",
    "membership",
    "paywall"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "hono": "^4.7.0",
    "drizzle-orm": "^0.45.0",
    "zod": "^4.6.7"
  },
  "kitsuden": {
    "type": "kon",
    "id": "kon-members",
    "core": false,
    "defaultEnabled": false,
    "host": "Provided by the Kitsuden host: @kitsuden/shared, @kitsuden/engine (compatibility = \"sdk\" in kon.json)"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kitsuden/kitsuden-kons.git",
    "directory": "kons/kon-members"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0"
  }
}
