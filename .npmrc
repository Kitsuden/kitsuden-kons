# Kons declare @kitsuden/shared, @kitsuden/engine, hono, drizzle-orm and zod as
# peerDependencies; they resolve from the root (linked to ./.kitsuden). Never
# let pnpm fetch a second copy of them from the registry.
auto-install-peers=false
resolve-peers-from-workspace-root=true
strict-peer-dependencies=false
